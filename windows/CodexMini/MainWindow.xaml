<Window x:Class="CodexMiniWin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ChatGPT Win"
        Width="1080"
        Height="720"
        MinWidth="980"
        MinHeight="650"
        MaxWidth="1220"
        MaxHeight="800"
        WindowStartupLocation="CenterScreen"
        Background="#10131A">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#191F2A"/>
        <SolidColorBrush x:Key="CardBrush" Color="#121821"/>
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#2D3A4D"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#93A1B5"/>
        <SolidColorBrush x:Key="SoftBrush" Color="#D7E0EC"/>
        <SolidColorBrush x:Key="CyanBrush" Color="#46D9F2"/>
        <SolidColorBrush x:Key="GreenBrush" Color="#68E596"/>
        <SolidColorBrush x:Key="OrangeBrush" Color="#FFB76C"/>
        <SolidColorBrush x:Key="PurpleBrush" Color="#B99AFF"/>

        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <Style x:Key="MetricCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="#273244"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Margin" Value="0,4,8,4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Foreground" Value="{StaticResource SoftBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#40506A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#10131A">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="96"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="54"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="42" Height="42" CornerRadius="12" Background="#123A49" BorderBrush="#2B7488" BorderThickness="1" VerticalAlignment="Center">
                    <TextBlock Text="&#xE8EA;" FontFamily="Segoe MDL2 Assets" FontSize="25" Foreground="{StaticResource CyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="ChatGPT Win" FontSize="26" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Windows 连接控制台 · 让手机 App 连接本机 ChatGPT" FontSize="13" Foreground="#8F9EB2" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Border Grid.Column="2" Height="34" MinWidth="110" Padding="12,0" CornerRadius="17" Background="#153B2B" BorderBrush="#2A6046" BorderThickness="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="StateDot" Text="●" Foreground="{StaticResource GreenBrush}" FontSize="12" Margin="0,0,8,0"/>
                        <TextBlock x:Name="StateText" Text="运行中" Foreground="{StaticResource GreenBrush}" FontWeight="Bold" FontSize="12"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="310"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource PanelStyle}" Padding="18,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="连接手机 App" Foreground="White" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="在 ChatGPT AZ 中扫描二维码" Foreground="#91A1B4" FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Border Width="184" Height="184" Padding="10" CornerRadius="12" Background="#F7FAFF">
                                <Image x:Name="QrImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            </Border>
                            <Border Height="28" Margin="0,12,0,0" Padding="12,0" CornerRadius="14" Background="#153B2B" BorderBrush="#2A6046" BorderThickness="1" HorizontalAlignment="Center">
                                <TextBlock x:Name="PhoneQrStatus" Text="入口就绪 / 等待手机" Foreground="{StaticResource GreenBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Row="2">
                            <TextBlock x:Name="QrUrl" Foreground="#8493A8" FontFamily="Consolas" FontSize="10" TextAlignment="Center" TextWrapping="Wrap" MaxHeight="32" TextTrimming="CharacterEllipsis"/>
                            <Button x:Name="CopyLinkButton" Style="{StaticResource LinkButtonStyle}" Margin="0,12,0,0" Content="&#xE71B; 复制连接地址" Click="CopyLink_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="104"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource PanelStyle}" Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource MetricCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="服务状态" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock x:Name="HttpValue" Text="-" Foreground="{StaticResource GreenBrush}" FontSize="22" FontWeight="Bold" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="HttpFootnote" Text="健康检查" Foreground="#77869A" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="手机入口" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock x:Name="PhoneValue" Text="待扫码" Foreground="{StaticResource CyanBrush}" FontSize="22" FontWeight="Bold" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="PhoneFootnote" Text="扫描二维码连接" Foreground="#77869A" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource MetricCardStyle}" Margin="0">
                                <StackPanel>
                                    <TextBlock Text="本机服务" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock x:Name="PortValue" Text="8787" Foreground="{StaticResource PurpleBrush}" FontSize="22" FontWeight="Bold" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="PortFootnote" Text="等待监听" Foreground="#77869A" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource PanelStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="电脑端控制" Foreground="White" FontSize="18" FontWeight="Bold"/>
                                    <TextBlock Text="服务只在本机运行，手机扫码后通过局域网连接" Foreground="#8B9BB0" FontSize="12" Margin="0,4,0,0"/>
                                </StackPanel>
                                <TextBlock x:Name="UpdatedAt" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#8090A4" FontFamily="Consolas" FontSize="11"/>
                            </Grid>
                            <UniformGrid Grid.Row="1" Rows="2" Columns="3" Margin="0,16,0,14">
                                <Button x:Name="OpenWebButton" Style="{StaticResource ActionButtonStyle}" Background="#1A4168" BorderBrush="#366C9F" Foreground="#91C6FF" Click="OpenWeb_Click"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,8,0"/><TextBlock Text="打开控制页" FontSize="12"/></StackPanel></Button>
                                <Button x:Name="LaunchCdpButton" Style="{StaticResource ActionButtonStyle}" Background="#163E2D" BorderBrush="#2E6E4E" Foreground="{StaticResource GreenBrush}" Click="LaunchCdp_Click"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,8,0"/><TextBlock Text="打开 ChatGPT" FontSize="12"/></StackPanel></Button>
                                <Button x:Name="RestartButton" Style="{StaticResource ActionButtonStyle}" Background="#4A311D" BorderBrush="#885F3A" Foreground="{StaticResource OrangeBrush}" Click="Restart_Click"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,8,0"/><TextBlock Text="重启服务" FontSize="12"/></StackPanel></Button>
                                <Button x:Name="OpenApkButton" Style="{StaticResource ActionButtonStyle}" Background="#30254A" BorderBrush="#675397" Foreground="{StaticResource PurpleBrush}" Click="OpenApk_Click"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,8,0"/><TextBlock Text="获取 Android App" FontSize="12"/></StackPanel></Button>
                                <Button x:Name="LanDiagnosticButton" Style="{StaticResource ActionButtonStyle}" Background="#202A42" BorderBrush="#4A5C90" Foreground="#B9C8FF" Click="LanDiagnostic_Click"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,8,0"/><TextBlock Text="局域网诊断" FontSize="12"/></StackPanel></Button>
                                <Button x:Name="RefreshButton" Style="{StaticResource ActionButtonStyle}" Background="#252D3A" BorderBrush="#516075" Foreground="{StaticResource SoftBrush}" Click="Refresh_Click"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,8,0"/><TextBlock Text="刷新状态" FontSize="12"/></StackPanel></Button>
                            </UniformGrid>
                            <DockPanel Grid.Row="2">
                                <StackPanel>
                                    <TextBlock Text="Android App 安装后即可扫描左侧二维码连接；APK 不会在 Windows 上直接运行。" Foreground="#8292A8" FontSize="11"/>
                                    <TextBlock x:Name="InstallPath" Foreground="#66778D" FontFamily="Consolas" FontSize="10" TextTrimming="CharacterEllipsis" MaxWidth="520"/>
                                </StackPanel>
                                <Button x:Name="OpenInstallerButton" DockPanel.Dock="Right" Style="{StaticResource LinkButtonStyle}" Content="Windows 安装包" Click="OpenInstaller_Click"/>
                            </DockPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource PanelStyle}" Margin="0,16,0,0" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="310"/>
                        <ColumnDefinition Width="104"/>
                        <ColumnDefinition Width="86"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="运行详情" Foreground="White" FontSize="13" FontWeight="Bold"/>
                        <TextBlock x:Name="LogPreview" Foreground="#8796AA" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock x:Name="EntryKind" Foreground="#738399" FontSize="10" HorizontalAlignment="Right"/>
                        <TextBlock x:Name="EntryUrl" Foreground="#A9B6C8" FontFamily="Consolas" FontSize="10" TextTrimming="CharacterEllipsis" Width="300" TextAlignment="Right"/>
                    </StackPanel>
                    <Button x:Name="OpenLogsButton" Grid.Column="2" Style="{StaticResource LinkButtonStyle}" Content="打开日志" Click="OpenLogs_Click" VerticalAlignment="Center"/>
                    <Button x:Name="StartStopButton" Grid.Column="3" Style="{StaticResource LinkButtonStyle}" Content="停止" Click="StartStop_Click" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
